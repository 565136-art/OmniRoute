{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/laya-shadow-record-v1.schema.json",
  "title": "Jarvis Laya Shadow Record v1",
  "description": "Flattened, bounded, non-authoritative Laya shadow telemetry shared by Supervisor and Task Observer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "attempt_id",
    "task_type",
    "request_id",
    "correlation_id",
    "authoritative_route",
    "actual_executor",
    "actual_model",
    "actual_provider",
    "laya_selected",
    "laya_abstain",
    "laya_confidence",
    "laya_latency_ms",
    "laya_peak_rss_bytes",
    "laya_fallback",
    "laya_fallback_reason",
    "laya_error_category",
    "laya_adapter_version",
    "input_tokens",
    "output_tokens",
    "cached_tokens",
    "cost",
    "retries",
    "final_success",
    "outcome_state",
    "agreement",
    "counterfactual_quality",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "$ref": "#/$defs/id" },
    "attempt_id": { "$ref": "#/$defs/id" },
    "task_type": { "$ref": "#/$defs/label" },
    "request_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "correlation_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "authoritative_route": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "actual_executor": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "actual_model": { "anyOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
    "actual_provider": { "anyOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
    "laya_selected": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "laya_abstain": { "type": ["boolean", "null"] },
    "laya_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "laya_latency_ms": { "$ref": "#/$defs/latency" },
    "laya_peak_rss_bytes": { "$ref": "#/$defs/rss" },
    "laya_fallback": { "type": ["boolean", "null"] },
    "laya_fallback_reason": { "anyOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
    "laya_error_category": { "anyOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
    "laya_adapter_version": { "anyOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
    "input_tokens": { "$ref": "#/$defs/token_count" },
    "output_tokens": { "$ref": "#/$defs/token_count" },
    "cached_tokens": { "$ref": "#/$defs/token_count" },
    "cost": { "$ref": "#/$defs/cost" },
    "retries": { "$ref": "#/$defs/retries" },
    "final_success": { "type": ["boolean", "null"] },
    "outcome_state": {
      "enum": ["pending", "waiting_approval", "success", "failure", "cancelled", "unknown"]
    },
    "agreement": { "enum": ["agree", "disagree", "unknown"] },
    "counterfactual_quality": {
      "enum": ["UNKNOWN", "SAME_QUALITY", "QUALITY_IMPROVEMENT", "QUALITY_REGRESSION", "FAILURE"]
    },
    "created_at": { "type": "string", "format": "date-time", "maxLength": 64 },
    "updated_at": { "type": "string", "format": "date-time", "maxLength": 64 }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "nonnegative": { "type": ["integer", "number", "null"], "minimum": 0 },
    "latency": { "type": ["integer", "null"], "minimum": 0, "maximum": 86400000 },
    "rss": { "type": ["integer", "null"], "minimum": 0, "maximum": 1099511627776 },
    "token_count": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000000 },
    "cost": { "type": ["number", "null"], "minimum": 0, "maximum": 1000000000 },
    "retries": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000 }
  },
  "x-max-record-bytes": 8192,
  "x-route-representation": "authoritative_route is the policy-selected executor ID string, never an object.",
  "x-agreement": ["agree", "disagree", "unknown"],
  "x-null-semantics": "Null or unknown telemetry never overwrites a known value.",
  "x-counterfactual-default": "UNKNOWN"
}
